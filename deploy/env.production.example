# 正式站設定樣板：在 VPS 上複製成 .env 後再填入真實值
#   cp .env.production.example .env && nano .env

NODE_ENV=production

# 網站只聽本機，由 Nginx 對外提供 HTTPS
HOST=127.0.0.1
PORT=3001

# 正式網址（必須和瀏覽器網址列完全一致，結尾不要加 /）
APP_ORIGIN=https://unity.nestw.net

# Nginx 在前面，讓 Express 讀取真實 IP 與 HTTPS 狀態
TRUST_PROXY=1

# 產生方式：openssl rand -hex 48
SESSION_SECRET=請貼上至少32字元的隨機字串

# 專用資料庫帳號（不要用 root），見 deploy/mysql-setup.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=unity_app
DB_PASSWORD=請改成資料庫密碼
DB_NAME=unity_packages
